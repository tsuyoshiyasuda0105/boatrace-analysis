# ============================================================
# 環境変数テンプレート
# 本番運用時はコピーして .env を作成してください
#   cp .env.example .env
# ============================================================

# ----- DB -----
# ローカル SQLite を使う場合は通常未設定で OK (data/boatrace.db に作成される)
BOATRACE_DB_PATH=

# ----- Supabase Postgres (本番Web UI 用) -----
# Session Pooler URL を入れる (IPv4 対応)
# 例: postgresql://postgres.xxx:pass@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
# これがあると同期スクリプト・daily_collect が自動的に Supabase にも書き込む
DATABASE_URL=

# ----- Web セッション -----
# 必ず長いランダム文字列に変更してください (本番)
# 生成例: python -c "import secrets;print(secrets.token_hex(32))"
BOATRACE_WEB_SECRET=change-me-to-long-random-string

# ----- 会員プラン認証 -----
# 通常会員 (EV+ マーク・What-if シミュレーター)
BOATRACE_MEMBER_PASSWORD=please-change-member-pw

# Pro プラン (T-15min 期待値モニター)
BOATRACE_PRO_PASSWORD=please-change-pro-pw
