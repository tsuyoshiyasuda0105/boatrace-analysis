# ============================================================
# 環境変数テンプレート
# 本番運用時はコピーして .env を作成してください
#   cp .env.example .env
# ============================================================

# ----- DB -----
# ローカル SQLite を使う場合は通常未設定で OK (data/boatrace.db に作成される)
BOATRACE_DB_PATH=

# ----- Supabase Postgres (本番Web UI 用) -----
# Session Pooler URL を入れる (IPv4 対応)
# 例: postgresql://postgres.xxx:pass@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres
# これがあると同期スクリプト・daily_collect が自動的に Supabase にも書き込む
DATABASE_URL=

# ----- Web セッション (必須・本番では絶対変更) -----
# Flask セッション署名キー。64文字以上のランダム16進文字列推奨。
# 生成: python -c "import secrets;print(secrets.token_hex(32))"
# ※デフォルト値のままだと本番で WARNING ログが出ます
BOATRACE_WEB_SECRET=change-me-to-long-random-string-64chars-recommended

# ----- 会員プラン認証 (必須・本番では絶対変更) -----
# 通常会員 (EV+ マーク・What-if シミュレーター)
# 16文字以上、英数字記号混在を推奨
# 生成: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%') for _ in range(20)))"
BOATRACE_MEMBER_PASSWORD=please-change-member-pw-min-16-chars

# Pro プラン (T-15min 期待値モニター)
# 上記と同様、別の強力なパスワードに
BOATRACE_PRO_PASSWORD=please-change-pro-pw-min-16-chars

# ----- セキュリティ補助 (任意) -----
# 朝L4候補機能を Render で完全に切る場合 true
# BOATRACE_DISABLE_MORNING_L4=false

# ----- メール購読機能 (必須・本番) -----
# メアド AES-GCM 暗号化用の鍵 (32 byte = 64 hex chars)
# 生成: python -c "import secrets;print(secrets.token_hex(32))"
# ※紛失すると暗号化されたメアドは全て復元不能になります
BOATRACE_EMAIL_KEY=set-to-64-hex-chars-via-secrets-token_hex32

# ===== メール送信バックエンド =====
# 優先順位: Brevo HTTP > Resend HTTP > SMTP
# Render Free Tier は SMTP outbound (port 587/465) を全面ブロックするため、
# 本番では HTTP API バックエンド (Brevo or Resend) のどちらかが必須。
# ローカル Task Scheduler や有料 PaaS は SMTP で OK。

# --- A. Brevo HTTP API (推奨・無料 300通/日) ---
# 1. https://www.brevo.com/ 登録
# 2. SMTP & API → API Keys → Generate a new API key
# 3. Senders & IP → 自分のメアドを認証 (確認メールクリック)
# 4. ここに API キー (xkeysib-... で始まる) を貼る
BOATRACE_BREVO_API_KEY=

# --- B. Resend HTTP API (代替・無料 100通/日) ---
# 1. https://resend.com/ 登録 → API Keys → Create API Key
# 2. デフォルト onboarding@resend.dev からテスト送信可 (本格運用は独自ドメイン認証)
BOATRACE_RESEND_API_KEY=

# --- C. SMTP (ローカル Task / 有料 PaaS 用、Render Free では使えない) ---
# 例 (Gmail): smtp.gmail.com / 587 / your@gmail.com / アプリパスワード
# 例 (Brevo): smtp-relay.brevo.com / 587 / xxxxxxx@smtp-brevo.com / SMTP key
BOATRACE_SMTP_HOST=
BOATRACE_SMTP_PORT=587
BOATRACE_SMTP_USER=
BOATRACE_SMTP_PASSWORD=
BOATRACE_SMTP_FROM=BOATRACE Alert <noreply@example.com>

# 公開 URL (メール本文のリンクで使う)
BOATRACE_SITE_URL=https://boatrace-web.onrender.com
